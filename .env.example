# Optional. Auto/Gemini Flash work better with a key.
GEMINI_API_KEY=

# Optional extra free Llama fallback from Groq.
GROQ_API_KEY=

# Optional extra free-tier fallback (Qwen, etc).
OPENROUTER_API_KEY=

# Required for /admin. Change this before deploy.
ADMIN_PASSWORD=

# Session signing secret. Use a long random string in production.
SESSION_SECRET=

# Optional. MongoDB Atlas URI so user chats sync across devices.
MONGODB_URI=

# Optional. Pollinations token so source images skip the source logo before crop.
POLLINATIONS_TOKEN=

# Optional. Sends password recovery codes by email.
RESEND_API_KEY=
MAIL_FROM=

# Optional. Continue with Google on /signin.
# Create OAuth credentials in Google Cloud Console.
# Authorized redirect URI: https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=
